# Copy to .env.local and fill in for local development.

# 32-byte hex string used to HMAC the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# The shared password for the login gate (ADR-007).
SHARED_PASSWORD=

# LLM provider selection. "mock" uses the deterministic mock provider
# (default for local dev). "azure" requires the AZURE_OPENAI_* values below.
LLM_PROVIDER=mock

# Azure OpenAI configuration (only used when LLM_PROVIDER=azure).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_MINI=
AZURE_OPENAI_DEPLOYMENT_FLAGSHIP=
